+object OpenTag3dV2Adapter {
+    val format = ExternalTagFormat(
+        id = "opentag3d-2.000",
+        displayName = "OpenTag3D 2.000",
+        mimeType = "application/opentag3d",
+        radioTechnology = "NFC-A / NDEF Type 2",
+        sourceRevision = "d0f706896e772663404edab8aa814633ba3c6543",
+    )
